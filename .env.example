# Copy to `.env` (git-ignored) and adjust. Environment variables override
# ~/.config/arthur/config.toml, which overrides built-in defaults.

# --- LLM (Ollama) -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
MODEL_NAME=llama3.2:1b
ARTHUR_LLM_EMBEDDING_MODEL=nomic-embed-text

# --- Storage ----------------------------------------------------------------
# Defaults to ~/.local/share/arthur/arthur.db when unset.
# ARTHUR_MEMORY_DATABASE=/home/you/.local/share/arthur/arthur.db

# --- Security ---------------------------------------------------------------
# Arbitrary shell access stays disabled unless explicitly turned on, and even
# then only allow-listed commands are executable.
ARTHUR_SECURITY_DEFAULT_SHELL_ACCESS=false
ARTHUR_SECURITY_REQUIRE_CONFIRMATION=true

# --- API --------------------------------------------------------------------
# When set, the API requires `Authorization: Bearer <token>`.
# The API always binds to 127.0.0.1 by default.
ARTHUR_API_TOKEN=change-me

# --- Logging ----------------------------------------------------------------
ARTHUR_LOGGING_LEVEL=INFO
# text | json
ARTHUR_LOGGING_FORMAT=text
